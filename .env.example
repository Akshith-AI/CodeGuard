# Add only the keys for providers you plan to use. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# KIMI_API_KEY is also accepted as an alias for MOONSHOT_API_KEY.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Optional: increases GitHub API rate limits for public repositories.
GITHUB_TOKEN=
